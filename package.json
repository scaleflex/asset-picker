{
  "name": "@scaleflex/asset-picker",
  "version": "1.4.1",
  "description": "Framework-agnostic Asset Picker for Scaleflex VXP DAM.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./define": {
      "source": "./src/define.ts",
      "types": "./dist/define.d.ts",
      "import": "./dist/define.js",
      "require": "./dist/define.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "hls.js": "^1.6.15",
    "lit": "^3.2.0",
    "@scaleflex/dam-core": "^0.3.0",
    "@scaleflex/dam-ui": "^0.3.0"
  },
  "peerDependencies": {
    "@scaleflex/uploader": "^1.9.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@scaleflex/uploader": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.0.0"
  },
  "scripts": {
    "dev": "vite serve --config vite.demo.config.ts",
    "build": "vite build",
    "build:demo": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:cdn": "vite build --config vite.cdn.config.ts"
  }
}